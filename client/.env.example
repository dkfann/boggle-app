# Copy to .env.local (gitignored) to override locally. Baked in at build
# time - changing this requires restarting `npm run dev` or rebuilding, not
# just refreshing the page. See the README for how to set this on Render.

# Word-definition lookup on the results screen. Defaults on; set to "false"
# to disable it entirely (no panel, no requests to the dictionary API).
# VITE_ENABLE_DEFINITIONS=false
